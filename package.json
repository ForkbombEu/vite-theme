{
  "name": "@forkbomb/vite-theme",
  "version": "0.1.0",
  "description": "Forkbomb visual system for Vite and VitePress projects",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.js",
    "./style.css": "./src/theme/index.css",
    "./tokens.css": "./src/theme/tokens.css",
    "./vitepress": "./src/vitepress/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "template",
    "install.sh",
    "README.md",
    "THEME.md",
    "AGENTS.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:docs": "vitepress build examples/vitepress",
    "preview": "vite preview",
    "preview:docs": "vitepress preview examples/vitepress",
    "test:theme": "node --test tests/theme.test.mjs",
    "test": "npm run test:theme && npm run build && npm run build:docs",
    "pack:check": "npm pack --dry-run",
    "check": "npm run test && npm run pack:check"
  },
  "dependencies": {
    "@fontsource/barlow-semi-condensed": "^5.3.0",
    "@fontsource/public-sans": "^5.3.0",
    "lottie-web": "^5.13.0"
  },
  "peerDependencies": {
    "vitepress": ">=1.6.0 <3",
    "vue": ">=3.5.0 <4"
  },
  "peerDependenciesMeta": {
    "vitepress": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitepress": "^1.6.4",
    "vue": "^3.5.42"
  },
  "overrides": {
    "vitepress": {
      "vite": "6.4.3"
    }
  },
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ForkbombEu/vite-theme.git"
  }
}
